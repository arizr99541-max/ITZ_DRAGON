local EATER_CONFIG = {
    Enabled = false,
    EatsPerFrame = 50,
    MaxSlot = 100,
}

local ConsumeRemote = ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem:FindFirstChild("Network") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Consume")
local totalEaten = 0
local speedTimer = 0
local speedCounter = 0
local slotIndex = 1
local eaterConnection = nil
local currentEatsPerSec = 0

local function ResetEat()
    slotIndex = 1
end

local function SetupHealthMonitor(char)
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        hum.HealthChanged:Connect(function(newHealth)
            if newHealth <= 0 then ResetEat() end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(char)
    ResetEat()
    SetupHealthMonitor(char)
end)

if LocalPlayer.Character then
    SetupHealthMonitor(LocalPlayer.Character)
end

local function OptimizedEat()
    if not EATER_CONFIG.Enabled or not ConsumeRemote then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        ResetEat()
        return
    end

    for i = 1, EATER_CONFIG.EatsPerFrame do
        local slot = slotIndex
        task.spawn(function()
            pcall(function()
                ConsumeRemote:InvokeServer(slot)
            end)
        end)
        totalEaten = totalEaten + 1
        speedCounter = speedCounter + 1
        slotIndex = slotIndex + 1
        if slotIndex > EATER_CONFIG.MaxSlot then
            slotIndex = 1
        end
    end

    speedTimer = speedTimer + 1
    if speedTimer >= 30 then
        currentEatsPerSec = speedCounter * 2
        speedCounter = 0
        speedTimer = 0
    end
end

